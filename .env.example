# StockLink private settings.
# 1) Make a copy of this file named exactly  .env  (same folder as server.js)
# 2) Fill in your own values. NEVER share .env, never upload it to GitHub, never paste it in chat.
#    (.gitignore and .dockerignore already keep it out of GitHub and Docker.)

# Copy the exact link Supabase shows you; the part after @ depends on your region.
# Supabase > Project Settings > Database > Connection string > "Session pooler" (port 5432).
# Replace [YOUR-PASSWORD] with your database password. If the password has @ # / ? : characters,
# change it in Supabase to letters and numbers only, or the link breaks.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Any long random text, 40+ characters. Pick once and NEVER change it (it protects invite codes).
SESSION_SECRET=

# Your own super-admin login, created on first start.
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=

# Leave these as they are on your PC. On the internet server set NODE_ENV=production and TRUST_PROXY=1.
# NODE_ENV=production
# TRUST_PROXY=1
# Do NOT set DEMO_MODE when real shops use the app.
